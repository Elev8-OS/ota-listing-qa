<%- include('partials/head', { title: 'Anmelden' }) %>
<div class="center-card card">
  <div class="brand-lockup"><img src="/elev8-logo.svg" alt="Elev8" /></div>
  <h1>Anmelden</h1>
  <p class="subtitle">OTA-Inserats-QA-Tool · Vier-Augen-Prinzip</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <label>E-Mail</label>
    <input type="email" name="email" required autofocus />
    <label>Passwort</label>
    <input type="password" name="password" required />
    <button type="submit" style="margin-top:16px">Anmelden</button>
  </form>

  <% if (devLoginEnabled && devUsers && devUsers.length) { %>
  <div class="dev-login-block" style="margin-top:24px; padding-top:16px; border-top:1px dashed #999;">
    <p class="subtitle" style="margin-bottom:8px;">
      Dev-Login (ohne Passwort) — nur zum schnellen Zugriff, nicht für Produktivbetrieb empfohlen
    </p>
    <% devUsers.forEach(function(u) { %>
      <form method="post" action="/dev-login/<%= u.id %>" style="display:inline-block; margin:4px 4px 0 0;">
        <button type="submit" class="secondary">
          Als <%= u.name %> (<%= u.role %>) anmelden
        </button>
      </form>
    <% }) %>
  </div>
  <% } %>
</div>
<%- include('partials/foot') %>
