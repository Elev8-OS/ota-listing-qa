<%- include('partials/head', { title: 'Ersteinrichtung' }) %>
<div class="center-card card">
  <div class="brand-lockup"><img src="/elev8-logo.svg" alt="Elev8" /></div>
  <h1>Ersteinrichtung</h1>
  <p class="subtitle">Es existiert noch kein Benutzer. Lege den ersten Account an — dieser erhält automatisch die Rolle <strong>Admin</strong> und kann danach weitere Benutzer (Bearbeiter/Prüfer) einladen.</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/setup">
    <label>Name</label>
    <input type="text" name="name" required />
    <label>E-Mail</label>
    <input type="email" name="email" required value="<%= defaultEmail %>" />
    <label>Passwort</label>
    <input type="password" name="password" required minlength="8" />
    <button type="submit" style="margin-top:16px">Admin-Account erstellen</button>
  </form>
</div>
<%- include('partials/foot') %>
